APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg2://postgres:localpassword@localhost:5432/ridepulse
RUNNER_DATABASE_URL=postgresql+psycopg2://ridepulse_runner:YOUR_RUNNER_PASSWORD_HERE@localhost:5432/ridepulse

# Local MinIO (switch to gcs and the real bucket to test GCS with ADC).
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=ridepulse-dbt-artifacts
OBJECT_STORAGE_PREFIX=dbt-tests
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=miniopassword

OPENAI_API_KEY=your-openai-api-key-here
