# ============================================
# DataPulse — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Provider ----
# Options: openai, anthropic, mistral, google
PROVIDER=your-desired-provider

# ---- LLM Configuration (API Keys) ----
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ---- Model Names based on Provider ----
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=your-desired-model
MISTRAL_MODEL=your-desired-model
GOOGLE_MODEL=your-desired-model

# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/dbname
# Versioned dataset execution source. In the current deployment it should point
# to the same Supabase project as DATABASE_URL; no domain-specific table is required.
SUPABASE_DATABASE_URL=
DQ_EXECUTION_BACKEND=auto
# For SQLite (development / testing):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Demo account secrets (required independently in production) ----
# Local/development may omit these and uses username fallbacks for a fresh DB.
DEMO_USER_PASSWORD=
DEMO_STEWARD_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Optional non-production public demo; requires an explicit password.
ENABLE_PUBLIC_DEMO=false
# DEMO_STEWARD_PASSWORD is used only when ENABLE_PUBLIC_DEMO=true.
RATE_LIMIT_HASH_KEY=
TRUSTED_PROXY_CIDRS=
UPLOAD_MAX_BYTES=104857600
UPLOAD_MAX_ROWS=1000000
UPLOAD_MAX_COLUMNS=128
UPLOAD_MAX_DECODED_BYTES=536870912
DEMO_WORKSPACE_ID=ws-browser

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Defaults to false in production and true elsewhere. Enable only when the
# legacy NYC Taxi compatibility fixture is intentionally required.
SEED_LEGACY_DEMO_DATASET=false

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Generated dbt artifact storage ----
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=ridepulse-dbt-artifacts
OBJECT_STORAGE_PREFIX=dbt-tests
OBJECT_STORAGE_REGION=us-east-1
# Local MinIO only. Leave endpoint and these credentials unset in production;
# production uses the standard AWS credential chain.
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=miniopassword

# Google Cloud Storage / Cloud Run:
# OBJECT_STORAGE_PROVIDER=gcs
# OBJECT_STORAGE_BUCKET=ridepulse-dbt-artifacts-asignmentvinuni
# Cloud Run uses its attached service account automatically. For local runs,
# use `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS.

# ---- AI Hook Logging (optional) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
